# Environment example for effective-engine

# Base URL for TaxiWebBooker API (or a proxy endpoint you control)
# Example: https://portal.taxiwebbooker.com/api
TAXIWEBBOOKER_BASE_URL=

# Optional API key/token for TaxiWebBooker
TAXIWEBBOOKER_API_KEY=

# Google Cloud project id used by cloudbuild/deploys
GOOGLE_PROJECT_ID=

# Runtime port (default 8080)
PORT=8080
